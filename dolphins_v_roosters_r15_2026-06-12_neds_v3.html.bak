<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>R15 — Dolphins v Roosters SGM (Neds)</title>
<style>
:root{--bg:#0f0f0f;--card:#1a1a1a;--border:#2a2a2a;--text:#e0e0e0;--dim:#888;--green:#00c853;--yellow:#ffc107;--orange:#ff9800;--red:#ff5252;--blue:#448aff;--accent:#ff6d00;--sb:#e22b2b;--neds:#00a651}
.neds-tag{background:var(--neds);color:#fff;font-size:10px;padding:1px 5px;border-radius:4px;font-weight:700;display:inline-block;margin-left:4px}
.src{font-size:10px;color:var(--dim);display:block;margin-top:1px}
*{margin:0;padding:0;box-sizing:border-box}
body{background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif;font-size:16px;line-height:1.5;-webkit-font-smoothing:antialiased;padding-bottom:80px}
.sticky{position:sticky;top:0;z-index:100;background:linear-gradient(135deg,#1a1a1a,#111);border-bottom:1px solid var(--border);padding:12px 16px;display:flex;align-items:center;justify-content:space-between}
.sticky .mu{font-weight:700;font-size:14px}.sticky .at{color:var(--dim);font-weight:400}
.sticky .od{text-align:right}.sticky .sp{font-weight:700;color:var(--blue)}.sticky .tt{font-size:13px;color:var(--dim)}
.hero{padding:20px 16px;text-align:center;border-bottom:1px solid var(--border)}
.hero .wp{font-size:64px;font-weight:900;letter-spacing:-2px}
.hero .wl{font-size:13px;color:var(--dim);text-transform:uppercase;letter-spacing:1px}
.hero .pred{font-size:18px;font-weight:600;margin-top:4px}
.hero .badge{display:inline-block;padding:3px 10px;border-radius:99px;font-size:12px;font-weight:600;margin:4px}
.bg-sb{background:var(--sb);color:#fff}
.bg-origin{background:#006bb6;color:#fff}
.card{margin:12px 16px;background:var(--card);border-radius:12px;border:1px solid var(--border);overflow:hidden}
.ch{padding:14px 16px;font-weight:700;font-size:15px;display:flex;align-items:center;gap:8px;border-bottom:1px solid var(--border)}
.ch .ic{font-size:18px}.cb{padding:14px 16px}.cb p{margin-bottom:8px;font-size:14px;color:#ccc}.cb p:last-child{margin-bottom:0}
.alert{margin:12px 16px;background:#1a0a0a;border:1px solid #ff525244;border-radius:12px;padding:14px 16px;display:flex;align-items:flex-start;gap:10px}
.alert-ic{font-size:20px;flex-shrink:0}.alert-t{font-weight:700;color:var(--red);font-size:13px;text-transform:uppercase;letter-spacing:.5px}
.alert-b{font-size:14px;color:#ccc;margin-top:2px}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:4px 0}
.grid3 .cl{background:#222;border-radius:8px;padding:12px 10px;text-align:center}
.grid3 .cl .lb{font-size:11px;color:var(--dim);text-transform:uppercase;letter-spacing:.5px}
.grid3 .cl .va{font-size:18px;font-weight:700;margin-top:2px}
.grid3 .cl .su{font-size:12px;color:var(--dim)}.gr{color:var(--green)}.rd{color:var(--red)}
.pr{display:flex;align-items:center;padding:10px 0;border-bottom:1px solid #222;gap:10px}.pr:last-child{border-bottom:none}
.prk{width:24px;text-align:center;font-weight:700;font-size:14px;color:var(--dim);flex-shrink:0}
.pri{flex:1;min-width:0}.prn{font-weight:600;font-size:14px}.prf{font-size:12px;color:var(--dim)}
.pba{display:inline-block;padding:1px 6px;border-radius:99px;font-size:10px;font-weight:700;margin-left:4px}
.ba-g{background:#00c85322;color:var(--green)}.ba-y{background:#ffc10722;color:var(--yellow)}.ba-r{background:#ff525222;color:var(--red)}
.pro{text-align:right;flex-shrink:0}.pro .pc{font-weight:700;font-size:15px;color:var(--sb)}.pro .bk{font-size:10px;color:var(--dim)}
.sgm{margin:12px 16px;border-radius:12px;overflow:hidden;border:2px solid transparent}
.sg-c{border-color:var(--green)}.sg-b{border-color:var(--yellow)}.sg-ct{border-color:var(--orange)}
.sg-cv{border-color:#a855f7;box-shadow:0 0 12px rgba(168,85,247,0.25)}
.sgh-cv{background:linear-gradient(90deg,#a855f711,#7c3aed11);color:#c084fc}
.cover-pill{background:linear-gradient(90deg,#a855f7,#7c3aed);color:#fff;font-size:10px;padding:2px 8px;border-radius:99px;font-weight:700;margin-left:auto;letter-spacing:.5px}
.cover-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;padding:8px 16px;background:#1a0a1a;font-size:11px}
.cover-grid .cg{text-align:center;color:#c084fc}
.cover-grid .cg .lb{font-size:9px;text-transform:uppercase;letter-spacing:.5px;opacity:0.7}
.cover-grid .cg .va{font-weight:700;font-size:13px;margin-top:1px}
.sgh{padding:12px 16px;font-weight:700;font-size:14px;display:flex;align-items:center;gap:8px}
.sg-c .sgh{background:#00c85311;color:var(--green)}.sg-b .sgh{background:#ffc10711;color:var(--yellow)}.sg-ct .sgh{background:#ff980011;color:var(--orange)}
.sgb{background:var(--card);padding:14px 16px}
.sgl{display:flex;align-items:center;padding:8px 0;border-bottom:1px solid #222;gap:8px}.sgl:last-child{border-bottom:none}
.sgl .dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.sg-c .sgl .dot{background:var(--green)}.sg-b .sgl .dot{background:var(--yellow)}.sg-ct .sgl .dot{background:var(--orange)}
.sgl .pk{flex:1;font-size:14px}.sgl .od{font-weight:700;font-size:14px}
.sgf{padding:10px 16px;background:#111;display:flex;justify-content:space-between;align-items:center;font-size:13px}
.sgf .po{font-weight:700;font-size:16px}.sgf .sk{color:var(--dim)}
.eb{display:flex;align-items:center;gap:10px;padding:8px 0}.eb .el{font-size:12px;color:var(--dim);min-width:70px}
.eb .et{flex:1;height:6px;background:#333;border-radius:3px;overflow:hidden}
.eb .ef{height:100%;border-radius:3px}.eb .ev{font-size:12px;font-weight:600;min-width:50px;text-align:right}
.sb-tag{background:var(--sb);color:#fff;font-size:10px;padding:1px 5px;border-radius:4px;font-weight:700;display:inline-block;margin-left:4px}
.exgrid{display:grid;grid-template-columns:1fr 1fr;gap:8px}@media(min-width:600px){.exgrid{grid-template-columns:1fr 1fr 1fr}}
.exc{background:#222;border-radius:8px;padding:12px}.exc .so{font-size:12px;color:var(--dim);font-weight:600}
.exc .px{font-size:14px;font-weight:700;margin-top:2px}.ln{color:#006bb6}.ls{color:#aaa}
.tml{display:grid;grid-template-columns:1fr 1fr;gap:8px;font-size:13px}
.tml .tms{background:#111;border-radius:8px;padding:10px}
.tml .tms .tmn{font-weight:700;font-size:14px;margin-bottom:6px;color:#ccc}
.tml .tms .pl{display:flex;padding:2px 0;border-bottom:1px solid #1a1a1a;gap:4px}
.tml .tms .pl .num{color:var(--dim);min-width:20px;font-weight:600}
.tml .tms .pl .nm{flex:1}.tml .tms .pl .pos{color:var(--dim);font-size:11px}
.tml .tms .out{background:#ff525211;border-radius:4px;padding:6px;margin-top:6px;font-size:11px;color:var(--red)}
.fab{position:fixed;bottom:20px;right:20px;background:var(--sb);color:#fff;border:none;border-radius:99px;padding:14px 24px;font-size:15px;font-weight:700;box-shadow:0 4px 20px rgba(226,43,43,0.4);cursor:pointer;z-index:200;text-decoration:none}
.disc{margin:20px 16px;padding:12px;background:#111;border-radius:8px;font-size:11px;color:#555;text-align:center;line-height:1.4}
details{margin:8px 0}details summary{padding:10px 0;font-weight:600;font-size:14px;cursor:pointer;color:var(--blue)}
details .in{padding:8px 0;font-size:13px;color:#aaa;line-height:1.6}
.bankroll{background:linear-gradient(135deg,#1a1a1a,#0d0d0d);border:1px solid var(--accent);border-radius:12px;margin:12px 16px;padding:14px 16px}
.bankroll .row{display:flex;justify-content:space-between;align-items:center;margin:4px 0;font-size:14px}
.bankroll .row .lbl{color:var(--dim);font-size:12px;text-transform:uppercase;letter-spacing:.5px}
.bankroll .row .val{font-weight:700;font-size:18px}
.bankroll .row .val.accent{color:var(--accent)}
.bankroll .row .val.green{color:var(--green)}
@media(max-width:374px){.hero .wp{font-size:48px}.grid3 .cl .va{font-size:15px}}
</style>
</head>
<body>

<div class="sticky">
  <div class="mu">DOL <span class="at">v</span> SYD <span style="font-size:12px;color:#888;">· R15 · Fri 8:00pm AEST</span><span class="neds-tag" style="margin-left:6px">NEDS</span></div>
  <div class="od"><div class="sp" style="color:var(--neds)">DOL $1.50</div><div class="tt">SYD $2.60 · O/U 50.5</div></div>
</div>

<div class="hero">
  <div class="wl">Dolphins Win Probability</div>
  <div class="wp">66%</div>
  <div style="margin-top:4px">
    <span class="neds-tag" style="font-size:12px;padding:3px 10px">Neds Live</span>
    <span class="badge bg-origin">Sydney Depleted</span>
  </div>
  <div class="pred">Dolphins 25 – 20 Roosters</div>
  <div style="font-size:12px;color:var(--dim);margin-top:2px">Stats Insider 10K sims · GoBet · Freetips · Rugby League Zone · Betseeker · bets.com.au Neds prices</div>
</div>

<div class="alert">
  <div class="alert-ic">⚠️</div>
  <div>
    <div class="alert-t">SYDNEY GUTTED — 7+ OUT</div>
    <div class="alert-b">Tedesco, Walker, Robson, Collins, Radley, Toia, Nawaqanitawase all OUT (Origin + injury). Dolphins spine intact: Katoa, Nikorima, Isaako, Farnworth. Suncorp home, 5-game streak.</div>
  </div>
</div>

<div class="bankroll">
  <div class="row"><div class="lbl">Bankroll</div><div class="val">$20.00</div></div>
  <div class="row"><div class="lbl">Bonus Bet Active</div><div class="val" style="color:#c084fc;font-size:16px">$10.00 BB</div></div>
  <div class="row"><div class="lbl">Total Deployable</div><div class="val green">$30.00</div></div>
  <div class="row"><div class="lbl">Target</div><div class="val accent">$100.00</div></div>
  <div class="row"><div class="lbl">Required Multi</div><div class="val green">5.0x</div></div>
  <div class="row"><div class="lbl">Promo</div><div class="val" style="font-size:12px;color:#c084fc">🛡️ NRL SGM Cover</div></div>
</div>

<div class="alert" style="background:linear-gradient(135deg,#1a0a1a,#0a0a1a);border-color:#a855f744">
  <div class="alert-ic">🛡️</div>
  <div>
    <div class="alert-t" style="color:#c084fc">NRL SGM COVER ACTIVE — Up to $50 back as bonus bet</div>
    <div class="alert-b">Activate the <strong>SGM Cover Tool</strong> in the Sportsbet app <strong>before placing</strong> your 3+ leg SGM. If your multi fails by exactly 1 leg → you receive up to $50 back as a bonus bet. This is what flips the 3-leg from a 4.5x punt to an EV-positive position.</div>
  </div>
</div>

<div class="card">
  <div class="ch"><span class="ic">📋</span> Confirmed Team Lists <span style="font-size:11px;color:var(--dim);margin-left:auto">Rugby League Zone · 24h fresh</span></div>
  <div class="cb">
    <div class="tml">
      <div class="tms">
        <div class="tmn">🐬 Dolphins (Home)</div>
        <div class="pl"><span class="num">1</span><span class="nm">Trai Fuller</span><span class="pos">FB</span></div>
        <div class="pl"><span class="num">2</span><span class="nm">Jamayne Isaako</span><span class="pos">W</span></div>
        <div class="pl"><span class="num">3</span><span class="nm">Jack Bostock</span><span class="pos">C</span></div>
        <div class="pl"><span class="num">4</span><span class="nm">Herbie Farnworth</span><span class="pos">C</span></div>
        <div class="pl"><span class="num">5</span><span class="nm">Tevita Naufahu</span><span class="pos">W</span></div>
        <div class="pl"><span class="num">6</span><span class="nm">Kodi Nikorima</span><span class="pos">5/8</span></div>
        <div class="pl"><span class="num">7</span><span class="nm">Isaiya Katoa (c)</span><span class="pos">HB</span></div>
        <div class="pl"><span class="num">8</span><span class="nm">Felise Kaufusi</span><span class="pos">P</span></div>
        <div class="pl"><span class="num">9</span><span class="nm">J. Marshall-King</span><span class="pos">H</span></div>
        <div class="pl"><span class="num">10</span><span class="nm">Francis Molo</span><span class="pos">P</span></div>
        <div class="pl"><span class="num">11</span><span class="nm">Connelly Lemuelu</span><span class="pos">SR</span></div>
        <div class="pl"><span class="num">12</span><span class="nm">Oryn Keeley</span><span class="pos">SR</span></div>
        <div class="pl"><span class="num">13</span><span class="nm">Morgan Knowles</span><span class="pos">L</span></div>
        <div style="font-size:12px;color:var(--dim);margin-top:4px">Int: Schneider, Donoghoe, Gilbert, Stone</div>
        <div class="out" style="background:#00c85311;color:var(--green)">SPINE INTACT · No Origin call-ups</div>
      </div>
      <div class="tms">
        <div class="tmn">🐓 Roosters (Away)</div>
        <div class="pl"><span class="num">1</span><span class="nm">Cody Ramsey</span><span class="pos">FB</span></div>
        <div class="pl"><span class="num">2</span><span class="nm">Billy Smith</span><span class="pos">W</span></div>
        <div class="pl"><span class="num">3</span><span class="nm">Reece Foley</span><span class="pos">C</span></div>
        <div class="pl"><span class="num">4</span><span class="nm">Egan Butcher</span><span class="pos">C</span></div>
        <div class="pl"><span class="num">5</span><span class="nm">Tommy Talau</span><span class="pos">W</span></div>
        <div class="pl"><span class="num">6</span><span class="nm">Hugo Savala</span><span class="pos">5/8</span></div>
        <div class="pl"><span class="num">7</span><span class="nm">DCE (c)</span><span class="pos">HB</span></div>
        <div class="pl"><span class="num">8</span><span class="nm">Naufahu Whyte</span><span class="pos">P</span></div>
        <div class="pl"><span class="num">9</span><span class="nm">Connor Watson</span><span class="pos">H</span></div>
        <div class="pl"><span class="num">10</span><span class="nm">Spencer Leniu</span><span class="pos">P</span></div>
        <div class="pl"><span class="num">11</span><span class="nm">Angus Crichton</span><span class="pos">SR</span></div>
        <div class="pl"><span class="num">12</span><span class="nm">Siua Wong</span><span class="pos">SR</span></div>
        <div class="pl"><span class="num">13</span><span class="nm">Salesi Foketi</span><span class="pos">L</span></div>
        <div style="font-size:12px;color:var(--dim);margin-top:4px">Int: Ioelu, Losalu, N.Butcher, Bassingthwaighte</div>
        <div class="out">OUT: Tedesco, Walker, Robson, Collins, Radley, Toia, Nawaqanitawase</div>
      </div>
    </div>
  </div>
</div>

<div class="card">
  <div class="ch"><span class="ic">💰</span> Live Odds <span class="neds-tag">Neds</span></div>
  <div class="cb">
    <div class="grid3">
      <div class="cl"><div class="lb">Dolphins ML</div><div class="va gr">$1.50</div><div class="su">implied 66.7%</div></div>
      <div class="cl"><div class="lb">Roosters ML</div><div class="va">$2.60</div><div class="su">implied 38.5%</div></div>
      <div class="cl"><div class="lb">DOL 1-12</div><div class="va gr">$3.00</div><div class="su">Neds margin market</div></div>
    </div>
    <div class="grid3" style="margin-top:8px">
      <div class="cl"><div class="lb">Over 50.5</div><div class="va">$1.90</div><div class="su">Neds</div></div>
      <div class="cl"><div class="lb">Under 50.5</div><div class="va gr">$1.90</div><div class="su">Neds · even money</div></div>
      <div class="cl"><div class="lb">DOL -5.5</div><div class="va">$1.90</div><div class="su">Line market</div></div>
    </div>
    <p style="font-size:11px;color:var(--dim);margin-top:8px">Neds prices from Sports News Australia + bets.com.au aggregator (48min old) · Confirm in Neds app before placing — Neds tightens margins on hot markets</p>
  </div>
</div>

<div class="card">
  <div class="ch"><span class="ic">🎯</span> Neds Try Scorers — Anytime</div>
  <div class="cb">
    <div class="pr">
      <div class="prk">1</div>
      <div class="pri"><div class="prn">Jamayne Isaako<span class="pba ba-g">NEDS TOP</span></div><div class="prf">54.4% model · 11 tries in 12 games · 6 in last 5</div></div>
      <div class="pro"><div class="pc">$1.87</div><div class="bk">Neds<span class="src">bets.com.au</span></div></div>
    </div>
    <div class="pr">
      <div class="prk">2</div>
      <div class="pri"><div class="prn">Jack Bostock</div><div class="prf">47.2% · Weak Roosters centre · 1.91 generally</div></div>
      <div class="pro"><div class="pc">~$1.91</div><div class="bk">Neds<span class="src">estimate</span></div></div>
    </div>
    <div class="pr">
      <div class="prk">3</div>
      <div class="pri"><div class="prn">Herbie Farnworth</div><div class="prf">38.5% · Elite centre, Suncorp boost</div></div>
      <div class="pro"><div class="pc">~$2.20</div><div class="bk">Neds<span class="src">estimate</span></div></div>
    </div>
    <div class="pr">
      <div class="prk">4</div>
      <div class="pri"><div class="prn">Isaako 2+ Tries<span class="pba ba-g">PAYOUT</span></div><div class="prf">22% prob · Best upside on Neds</div></div>
      <div class="pro"><div class="pc">~$3.20</div><div class="bk">Neds<span class="src">estimate</span></div></div>
    </div>
  </div>
</div>

<div class="card">
  <div class="ch"><span class="ic">📊</span> Edge Analysis</div>
  <div class="cb">
    <div class="eb"><div class="el">Dolphins ML</div><div class="et"><div class="ef" style="width:66%;background:var(--blue)"></div></div><div class="ev" style="color:var(--green)">+0.5%</div></div>
    <div class="eb"><div class="el">Roosters ML</div><div class="et"><div class="ef" style="width:34%;background:#aaa"></div></div><div class="ev" style="color:var(--dim)">-3.0%</div></div>
    <div class="eb"><div class="el">Under 50.5</div><div class="et"><div class="ef" style="width:54%;background:var(--yellow)"></div></div><div class="ev" style="color:var(--green)">+4.0%</div></div>
    <div class="eb"><div class="el">Isaako Anytime</div><div class="et"><div class="ef" style="width:60%;background:var(--green)"></div></div><div class="ev" style="color:var(--green)">+5.0%</div></div>
    <p style="font-size:12px;color:var(--dim);margin-top:8px">DOL ML slight edge after Origin depletion adjustment. Under 50.5 supported by Stats Insider sim (25-20 = 45 total) and 3/5 H2H unders. Isaako 54.4% model vs 62.9% implied (1.59) = +5c edge.</p>
  </div>
</div>

<div class="card">
  <div class="ch"><span class="ic">🎯</span> Try Scorers — Anytime</div>
  <div class="cb">
    <div class="pr">
      <div class="prk">1</div>
      <div class="pri"><div class="prn">Jamayne Isaako<span class="pba ba-g">HOT</span></div><div class="prf">54.4% prob · 6 tries in last 5 games · 11 in 12 this season</div></div>
      <div class="pro"><div class="pc">$1.59</div><div class="bk">Sportsbet</div></div>
    </div>
    <div class="pr">
      <div class="prk">2</div>
      <div class="pri"><div class="prn">Jack Bostock<span class="pba ba-y">VALUE</span></div><div class="prf">47.2% prob · Dangerous since ACL return, weak Roosters centre</div></div>
      <div class="pro"><div class="pc">$1.91</div><div class="bk">Sportsbet</div></div>
    </div>
    <div class="pr">
      <div class="prk">3</div>
      <div class="pri"><div class="prn">Herbie Farnworth</div><div class="prf">38.5% prob · Elite centre, Suncorp crowd boost</div></div>
      <div class="pro"><div class="pc">$2.15</div><div class="bk">Sportsbet</div></div>
    </div>
    <div class="pr">
      <div class="prk">4</div>
      <div class="pri"><div class="prn">Isaako 2+ Tries<span class="pba ba-g">PAYOUT</span></div><div class="prf">22.0% prob · 3rd career multi-try last month · Best upside</div></div>
      <div class="pro"><div class="pc">$3.05</div><div class="bk">Sportsbet</div></div>
    </div>
    <div class="pr">
      <div class="prk">5</div>
      <div class="pri"><div class="prn">DCE Anytime<span class="pba ba-y">SYD TOP</span></div><div class="prf">28.4% prob · Roosters best creative, fatigue factor at 36</div></div>
      <div class="pro"><div class="pc">$2.80</div><div class="bk">Sportsbet</div></div>
    </div>
    <div class="pr">
      <div class="prk">6</div>
      <div class="pri"><div class="prn">Connor Watson</div><div class="prf">24.6% prob · Dummy-half try threat, Roosters best forward chance</div></div>
      <div class="pro"><div class="pc">$3.10</div><div class="bk">Sportsbet</div></div>
    </div>
  </div>
</div>

<div class="card">
  <div class="ch"><span class="ic">🧠</span> Expert Consensus</div>
  <div class="cb">
    <div class="exgrid">
